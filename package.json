{
  "name": "playwright-ai-self-healing-framework",
  "version": "1.0.0",
  "description": "Playwright TypeScript framework demonstrating agent-assisted planning, generation, and repair on the zeouf storefront, with additional UI and API examples.",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --project=api --project=chromium --grep @smoke",
    "test:happy": "playwright test --grep @happy",
    "test:regression": "playwright test --grep @regression",
    "test:negative": "playwright test --grep @negative",
    "test:api": "playwright test --project=api",
    "test:ui": "playwright test --project=chromium --project=firefox --project=webkit",
    "test:ecommerce": "playwright test --project=ecommerce-chromium",
    "test:ecommerce:isolated": "node scripts/run-ecommerce-isolated.js",
    "test:ecommerce:fixtures": "playwright test tests/ecommerce/catalog-boundaries-fixture.spec.ts tests/ecommerce/catalog-fixture.spec.ts tests/ecommerce/catalog-refinements-fixture.spec.ts tests/ecommerce/product-card-fixture.spec.ts tests/ecommerce/search-fixture.spec.ts tests/ecommerce/category-membership-fixture.spec.ts --project=ecommerce-chromium",
    "test:ecommerce:navigation": "playwright test tests/ecommerce/navigation-accessibility.spec.ts tests/ecommerce/home-destinations.spec.ts --project=ecommerce-chromium",
    "test:ecommerce:monitoring-pilot": "playwright test tests/ecommerce/auth-confirmation-mismatch.spec.ts tests/ecommerce/auth-confirmation-blank.spec.ts tests/ecommerce/cart-guest-denial.spec.ts tests/ecommerce/newsletter-preview.spec.ts tests/ecommerce/auth-password-visibility.spec.ts tests/ecommerce/search-input.spec.ts tests/ecommerce/product-information.spec.ts --project=ecommerce-chromium",
    "monitor:ecommerce": "node scripts/build-ecommerce-monitoring.js",
    "test:monitoring": "node --test scripts/build-ecommerce-monitoring.test.js",
    "demo:ecommerce:repair": "node scripts/evaluate-ecommerce-repair.js",
    "test:repair-evaluation": "node --test scripts/evaluate-ecommerce-repair.test.js",
    "test:ecommerce:api": "playwright test --project=ecommerce-api",
    "test:ecommerce:contracts": "node scripts/run-ecommerce-contracts.js",
    "cases:zeouf:catalog": "node scripts/build-ecommerce-case-catalog.js && prettier --write specs/ecommerce/requirements/CASE_CATALOG.md specs/ecommerce/requirements/case-catalog.json",
    "perf:ecommerce:smoke": "k6 run performance/ecommerce/smoke.js",
    "perf:ecommerce:baseline": "node scripts/collect-ecommerce-browser-metrics.js",
    "perf:ecommerce:check": "node scripts/collect-ecommerce-browser-metrics.js --check-budget",
    "test:ecommerce:smoke": "playwright test --project=ecommerce-chromium --grep @smoke",
    "test:ecommerce:happy": "playwright test --project=ecommerce-chromium --grep @happy",
    "test:ecommerce:regression": "playwright test --project=ecommerce-chromium --grep @regression",
    "test:headed": "playwright test --headed",
    "report": "playwright show-report",
    "test:allure": "allure run -- playwright test",
    "allure:generate": "allure generate allure-results --output allure-report",
    "allure:open": "allure open allure-report",
    "record": "playwright codegen https://practice.expandtesting.com/inputs",
    "summarize:results": "node scripts/summarize-playwright-results.js",
    "analyze": "node scripts/static-analysis.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check \"fixtures/**/*.ts\" \"tests/**/*.ts\" \"tests/**/*.js\" \"utils/**/*.ts\" \"flows/**/*.ts\" \"pages/**/*.ts\" \"scripts/**/*.js\" \"tools/ecommerce-workspace/*\" playwright.config.ts playwright.matrix.config.ts tsconfig.json package.json",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run analyze && npm run test:monitoring && npm run test:repair-evaluation && npm run cases:zeouf:mappings && npm run test:mappings && npm run test:repair-loop && npm run test:requirements-updates && npm run test:native-runner && npm run test:ci-report && npm run test:history && npm run test:integration-policy && npm run test:workspace",
    "prepare": "husky install",
    "test:ecommerce:read-only": "node scripts/run-ecommerce-read-only.js",
    "cases:zeouf:mappings": "node scripts/check-ecommerce-mappings.js",
    "cases:zeouf:backlog": "node scripts/build-ecommerce-automation-backlog.js && prettier --write specs/ecommerce/automation-backlog.md",
    "test:mappings": "node --test scripts/check-ecommerce-mappings.test.js",
    "repair:ecommerce": "node scripts/run-ecommerce-repair.js",
    "test:repair-loop": "node --test scripts/ecommerce-repair/*.test.js",
    "repair:ecommerce:ci": "node scripts/ecommerce-repair/ci.js",
    "repair:ecommerce:publish": "node scripts/ecommerce-repair/publish.js",
    "verify:website-pr": "node scripts/ecommerce-repair/verify-website-pr.js",
    "prepare:website-integration": "node scripts/ecommerce-repair/prepare-website-integration.js",
    "test:requirements-updates": "node --test scripts/reviewed-requirement-updates.test.js",
    "test:ecommerce:native": "node scripts/run-ecommerce-native.js",
    "test:native-runner": "node --test scripts/run-ecommerce-native.test.js",
    "test:ci-report": "node --test scripts/ci-report.test.js",
    "test:ecommerce:integration": "node scripts/run-ecommerce-integration.js",
    "test:ecommerce:matrix": "playwright test --config=playwright.matrix.config.ts",
    "history:ecommerce": "node scripts/record-ecommerce-history.js",
    "test:history": "node --test scripts/ecommerce-history.test.js",
    "test:integration-policy": "node --test scripts/ecommerce-integration/target.test.js",
    "benchmark:ecommerce:offline": "node scripts/run-ecommerce-agent-benchmark.js",
    "workspace:ecommerce": "node scripts/ecommerce-workspace.js",
    "test:workspace": "node --test scripts/ecommerce-workspace.test.js",
    "verify:workspace": "node scripts/verify-ecommerce-workspace.js"
  },
  "keywords": [
    "playwright",
    "typescript",
    "testing",
    "mcp",
    "self-healing"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.3.0",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "allure": "^3.18.0",
    "allure-playwright": "^3.12.2",
    "eslint": "^8.48.0",
    "eslint-config-prettier": "^9.0.0",
    "husky": "^8.0.0",
    "lint-staged": "^17.5.1",
    "prettier": "^3.2.0",
    "supabase": "3.1.0"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "overrides": {
    "glob@>=9 <14.0.2": "14.0.2",
    "minimatch@>=7 <11.0.1": "11.0.1"
  }
}
