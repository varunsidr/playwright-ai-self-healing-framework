{
  "name": "playwright-ai-self-healing-framework",
  "version": "1.0.0",
  "description": "Playwright TypeScript framework demonstrating agent-assisted planning, generation, and repair on the zeouf storefront, with additional UI and API examples.",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --project=api --project=chromium --grep @smoke",
    "test:happy": "playwright test --grep @happy",
    "test:regression": "playwright test --grep @regression",
    "test:negative": "playwright test --grep @negative",
    "test:api": "playwright test --project=api",
    "test:ui": "playwright test --project=chromium --project=firefox --project=webkit",
    "test:ecommerce": "playwright test --project=ecommerce-chromium",
    "test:ecommerce:fixtures": "playwright test tests/ecommerce/catalog-fixture.spec.ts tests/ecommerce/catalog-refinements-fixture.spec.ts tests/ecommerce/product-card-fixture.spec.ts tests/ecommerce/search-fixture.spec.ts tests/ecommerce/cart-storage-fixture.spec.ts tests/ecommerce/currency-fixture.spec.ts --project=ecommerce-chromium",
    "test:ecommerce:navigation": "playwright test tests/ecommerce/navigation-accessibility.spec.ts tests/ecommerce/home-destinations.spec.ts --project=ecommerce-chromium",
    "test:ecommerce:monitoring-pilot": "playwright test tests/ecommerce/auth-confirmation-mismatch.spec.ts tests/ecommerce/auth-confirmation-blank.spec.ts tests/ecommerce/cart-guest-denial.spec.ts tests/ecommerce/cart-malformed-storage.spec.ts tests/ecommerce/newsletter-preview.spec.ts tests/ecommerce/auth-password-visibility.spec.ts tests/ecommerce/search-input.spec.ts tests/ecommerce/product-information.spec.ts --project=ecommerce-chromium",
    "monitor:ecommerce": "node scripts/build-ecommerce-monitoring.js",
    "test:monitoring": "node --test scripts/build-ecommerce-monitoring.test.js",
    "demo:ecommerce:repair": "node scripts/evaluate-ecommerce-repair.js",
    "test:repair-evaluation": "node --test scripts/evaluate-ecommerce-repair.test.js",
    "test:ecommerce:api": "playwright test --project=ecommerce-api",
    "cases:zeouf:catalog": "node scripts/build-ecommerce-case-catalog.js && prettier --write specs/ecommerce/requirements/CASE_CATALOG.md specs/ecommerce/requirements/case-catalog.json",
    "perf:ecommerce:smoke": "k6 run performance/ecommerce/smoke.js",
    "perf:ecommerce:baseline": "node scripts/collect-ecommerce-browser-metrics.js",
    "perf:ecommerce:check": "node scripts/collect-ecommerce-browser-metrics.js --check-budget",
    "test:ecommerce:smoke": "playwright test --project=ecommerce-chromium --grep @smoke",
    "test:ecommerce:happy": "playwright test --project=ecommerce-chromium --grep @happy",
    "test:ecommerce:regression": "playwright test --project=ecommerce-chromium --grep @regression",
    "test:headed": "playwright test --headed",
    "report": "playwright show-report",
    "test:allure": "allure run -- playwright test",
    "allure:generate": "allure generate allure-results --output allure-report",
    "allure:open": "allure open allure-report",
    "record": "playwright codegen https://practice.expandtesting.com/inputs",
    "summarize:results": "node scripts/summarize-playwright-results.js",
    "analyze": "node scripts/static-analysis.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check \"fixtures/**/*.ts\" \"tests/**/*.ts\" \"utils/**/*.ts\" \"flows/**/*.ts\" \"pages/**/*.ts\" \"scripts/**/*.js\" playwright.config.ts tsconfig.json package.json",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run analyze && npm run test:monitoring && npm run test:repair-evaluation",
    "prepare": "husky install"
  },
  "keywords": [
    "playwright",
    "typescript",
    "testing",
    "mcp",
    "self-healing"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.3.0",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "allure": "^3.18.0",
    "allure-playwright": "^3.12.2",
    "eslint": "^8.48.0",
    "eslint-config-prettier": "^9.0.0",
    "husky": "^8.0.0",
    "lint-staged": "^17.5.1",
    "prettier": "^3.2.0"
  }
}
