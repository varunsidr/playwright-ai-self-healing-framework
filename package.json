{
  "name": "playwright-ai-self-healing-framework",
  "version": "1.0.0",
  "description": "AI-assisted Playwright TypeScript framework for the Expand Testing inputs page with self-healing-friendly test structure.",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "report": "playwright show-report",
    "record": "playwright codegen https://practice.expandtesting.com/inputs",
    "analyze": "node scripts/static-analysis.js",
    "lint": "eslint . --ext .ts --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check \"fixtures/**/*.ts\" \"tests/**/*.ts\" \"utils/**/*.ts\" \"flows/**/*.ts\" \"pages/**/*.ts\" \"scripts/**/*.js\" playwright.config.ts tsconfig.json package.json",
    "prepare": "husky install"
  },
  "keywords": [
    "playwright",
    "typescript",
    "testing",
    "mcp",
    "self-healing"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.3.0",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "eslint": "^8.48.0",
    "eslint-config-prettier": "^9.0.0",
    "husky": "^8.0.0",
    "lint-staged": "^17.5.1",
    "prettier": "^3.2.0"
  }
}
